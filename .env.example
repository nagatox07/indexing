# ==============================================================================
# ChainIndex - Environment Variables Configuration
# ==============================================================================
# Copy this file to '.env' and fill in your actual values.
# NEVER commit the actual '.env' file to Git as it contains sensitive private keys!

# 1. Base Sepolia RPC URL
# An RPC (Remote Procedure Call) endpoint connects your application to the blockchain node.
# You can use a free public RPC or a provider like Alchemy, QuickNode, or Infura.
# Public RPC: https://sepolia.base.org
BASE_SEPOLIA_RPC_URL="https://sepolia.base.org"

# 2. Deployer Private Key
# The private key of your testnet wallet used to sign contract deployment transactions.
# Format: 64 hex characters (with or without '0x' prefix).
# CAUTION: ONLY use a testnet-dedicated wallet! Never use a wallet holding real mainnet funds.
DEPLOYER_PRIVATE_KEY=""

# 3. PostgreSQL Database Connection URL
# Connection string for your PostgreSQL database used by Ponder to store indexed events.
# Format: postgresql://[user]:[password]@[host]:[port]/[database_name]
# Example for local cluster: postgresql://debashish-pradhan@localhost:5432/chainindex
DATABASE_URL="postgresql://localhost:5432/chainindex"

# 4. ChainIndex Port Configuration (optional, default: 42069)
# Port where Ponder serves its built-in GraphQL API and Hono REST API.
PORT=42069
