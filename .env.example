# ==============================================================================
# ChainIndex - Environment Variables Configuration
# ==============================================================================
# Copy this file to '.env' and fill in your actual values.
# NEVER commit the actual '.env' file to Git as it contains sensitive private keys!

# 1. Ethereum Sepolia RPC URL
# An RPC (Remote Procedure Call) endpoint connects your application to the Ethereum Sepolia testnet.
# Public RPC examples: https://ethereum-sepolia-rpc.publicnode.com or https://rpc.sepolia.org
# Or your dedicated provider RPC (Alchemy, Infura, QuickNode).
SEPOLIA_RPC_URL="https://ethereum-sepolia-rpc.publicnode.com"

# 2. Deployer Private Key
# The private key of your funded Ethereum Sepolia test wallet used to sign contract deployments.
# Format: 64 hex characters (with or without '0x' prefix).
# CAUTION: ONLY use a testnet-dedicated wallet! Never use a wallet holding real mainnet funds.
DEPLOYER_PRIVATE_KEY=""

# 3. PostgreSQL Database Connection URL
# Connection string for your PostgreSQL database used by Ponder to store indexed events.
# TCP form (needs a password for the role):
#   DATABASE_URL="postgresql://chainindex:pw@localhost:5432/chainindex"
# Local unix socket form (no password needed; use `whoami` as the role):
#   DATABASE_URL="postgresql:///chainindex?host=/var/run/postgresql"
# Create the database once with:  createdb chainindex
DATABASE_URL="postgresql://localhost:5432/chainindex"

# 4. API keys for the REST/GraphQL API (comma-separated, at least one required)
# Send the key as the `x-api-key` header, an `Authorization: Bearer <key>` token,
# or the `?apiKey=` query parameter. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
API_KEYS=""

# 5. Port for the Ponder server (health, GraphQL, REST API). Default: 42069
PORT=42069

# ------------------------------------------------------------------------------
# Fill these in AFTER deploying to Ethereum Sepolia (see README "Deploy").
# Use the block number of the deployment transaction so the indexer only scans
# from that point onwards.
# ------------------------------------------------------------------------------
DATA_REGISTRY_ADDRESS=""
DATA_REGISTRY_START_BLOCK=""
DEMO_TOKEN_ADDRESS=""
DEMO_TOKEN_START_BLOCK=""

# ------------------------------------------------------------------------------
# Dashboard (optional). Set before running `npm run build:dashboard` if the API
# is not reachable at http://localhost:42069.
# ------------------------------------------------------------------------------
VITE_API_URL="http://localhost:42069"
