{
  "name": "chainindex",
  "version": "0.1.0",
  "private": true,
  "description": "Developer-facing blockchain indexing and API SaaS targeting Base Sepolia",
  "type": "module",
  "scripts": {
    "dev": "ponder dev",
    "start": "ponder start",
    "build": "npm run compile:contracts && ponder codegen",
    "compile:contracts": "cd contracts && forge build && cd .. && npm run sync:abis",
    "sync:abis": "node scripts/sync-abis.js",
    "typecheck": "tsc --noEmit",
    "test:contracts": "cd contracts && forge test -vvv"
  },
  "dependencies": {
    "hono": "^4.7.4",
    "pg": "^8.13.3",
    "ponder": "^0.18.0",
    "viem": "^2.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/pg": "^8.11.11",
    "typescript": "^5.8.2"
  }
}
