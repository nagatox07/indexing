{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": [
      "ES2022"
    ],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "noEmit": true
  },
  "include": [
    "src/**/*",
    "abis/**/*",
    "ponder.config.ts",
    "ponder.schema.ts",
    "ponder-env.d.ts"
  ],
  "exclude": [
    "node_modules",
    "contracts",
    "postgres_data"
  ]
}